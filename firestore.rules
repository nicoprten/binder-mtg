rules_version = '2';

// Replace the email below with the Google account you sign in with, then
// paste these rules in Firebase Console → Firestore Database → Rules.
// Cards are readable by anyone (the public "Cards to trade" page needs
// them); everything else is readable and writable only by the editor.
service cloud.firestore {
  match /databases/{database}/documents {
    function isEditor() {
      return request.auth != null
        && request.auth.token.email in ['YOUR_GOOGLE_EMAIL@gmail.com'];
    }

    match /cards/{card} {
      allow read: if true;
      allow write: if isEditor();
    }

    match /{collection}/{document=**} {
      allow read, write: if isEditor();
    }
  }
}
