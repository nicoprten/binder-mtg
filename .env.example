# Firebase web app config (Firebase Console → Project settings → Your apps → Web app).
# These identify the project and are not secrets; Firestore rules protect the data.
# Leave them empty to run the app from the bundled JSON files only.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Comma-separated Google account emails that see the whole binder and can edit.
# Any other Google account only sees the cards to trade. Empty means nobody gets in.
VITE_EDITOR_EMAILS=
